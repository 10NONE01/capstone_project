# Copy this file to .env and fill in your own values.
# Never commit .env.
#
# Generate each secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Required: protects login sessions
SESSION_SECRET=

# Recommended: protects audit log integrity. Keep this value when
# changing SESSION_SECRET so existing audit entries still verify.
AUDIT_HMAC_KEY=

# Optional: failed login limits per 15 minutes
# LOGIN_MAX_ATTEMPTS_IP=20
# LOGIN_MAX_ATTEMPTS_ACCOUNT=10

# Only when deployed behind HTTPS and one reverse proxy
# NODE_ENV=production
# TRUST_PROXY=1
